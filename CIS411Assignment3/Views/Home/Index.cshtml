@{
    ViewData["Title"] = "Art Search";
}

<h2>Search for an Artwork</h2>

<form asp-action="Search" method="post">
    <input type="text" name="query" placeholder="Enter artwork name..." required />
    <button type="submit">Search</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red;">@ViewBag.Error</p>
}
